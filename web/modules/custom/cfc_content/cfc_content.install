      ["Country Focus — Côte d'Ivoire 2025", '2025-05-01', '20 pages', 'Updated'],
      ['Country Focus — Nigeria 2025', '2025-04-01', '24 pages', NULL],
      ['Country Focus — Kenya 2025', '2025-04-01', '20 pages', NULL],
      ['Country Focus — Senegal 2025', '2025-03-01', '18 pages', NULL],
    ],
    'africa-news' => [
