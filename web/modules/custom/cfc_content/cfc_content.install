/**
 * Builds the missing entity form + view displays for "space" and
 * "production" — without these, the admin edit form for these nodes only
 * shows the Title field, since our fields were created via code (not the
 * Field UI, which is what normally auto-generates these displays).
 */
function cfc_content_update_11004(): void {
  $space_fields = [
    'field_machine_key', 'field_subtitle', 'field_summary', 'field_price_label',
    'field_capacity_meta', 'field_access_rule', 'field_highlight', 'field_hero_image',
    'field_features', 'field_slot_durations', 'field_max_guests', 'field_cta_label',
    'field_weight', 'field_description', 'field_concurrent_capacity', 'field_hourly_rate',
    'field_currency',
  ];
  $production_fields = [
    'field_production_type', 'field_publisher', 'field_duration', 'field_production_date',
    'field_image', 'field_featured', 'field_description',
  ];

  _cfc_content_build_default_displays('space', $space_fields);
  _cfc_content_build_default_displays('production', $production_fields);
}

/**
 * Creates (or completes) the default form + view display for a bundle,
 * assigning a widget/formatter per field based on its storage type (see
 * CFC_CONTENT_FIELD_DISPLAY_MAP). Safe to re-run: setComponent() overwrites.
 */
function _cfc_content_build_default_displays(string $bundle, array $field_names): void {
  $field_definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', $bundle);
  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('node', $bundle, 'default');
  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('node', $bundle, 'default');

  $weight = 0;
  foreach ($field_names as $field_name) {
    if (!isset($field_definitions[$field_name])) {
      continue;
    }
    $field_type = $field_definitions[$field_name]->getType();
    $map = CFC_CONTENT_FIELD_DISPLAY_MAP[$field_type] ?? NULL;
    if (!$map) {
      continue;
    }
    $form_display->setComponent($field_name, ['type' => $map['widget'], 'weight' => $weight]);
    $view_display->setComponent($field_name, ['type' => $map['formatter'], 'weight' => $weight]);
    $weight++;
  }
  $form_display->save();
  $view_display->save();
}

/**
 * Helper to create field storage + field instances for a bundle.
 */
function _cfc_content_create_fields(string $entity_type, string $bundle, array $fields): void {
  foreach ($fields as $field_name => $spec) {
    if (!FieldStorageConfig::loadByName($entity_type, $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => $entity_type,
        'type' => $spec['type'],
        'settings' => $spec['settings'] ?? [],
        'cardinality' => $spec['cardinality'] ?? 1,
      ])->save();
    }

    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'label' => $spec['label'],
      'required' => $spec['required'] ?? FALSE,
      'description' => $spec['description'] ?? '',
    ])->save();
  }
}

/**
 * Re-shapes "Space" field_features from a flat string list into
 * "icon|Title|Subtitle" entries (parsed by ContentRepository::mapSpace())
 * so the "Includes" grid on /spaces shows a per-feature icon + bold title +
 * subtitle, matching the Figma reference, instead of a generic checkmark
 * with a single line of text. Backfills the exact Desk/Meeting Room/Studio
 * feature list from that reference.
 */
function cfc_content_update_11007(): void {
  $field_config = FieldConfig::loadByName('node', 'space', 'field_features');
  if ($field_config) {
    $field_config->setDescription('One per line, as "icon|Title|Subtitle" (icon = a filename from the icon component, e.g. "monitor"). Shown as the "Includes" cards on /spaces.');
    $field_config->save();
  }

  $features_by_key = [
    'desk' => [
      'monitor|Desk|Dedicated workstation',
      'wifi|Internet|Dedicated connection',
      'printer|Print|On-site printing',
    ],
    'meeting' => [
      'lock|Private room|Video conferencing · 6 seats',
      'monitor|Presentation|4K display + whiteboard',
      'video|Video call|Zoom, Teams, Meet',
    ],
    'studio' => [
      'camera|3 Cameras|Professional setup',
      'mic|3 Microphones|Integrated Lighting',
      'video|Control Room|Mobile · Technician',
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($storage->loadByProperties(['type' => 'space']) as $node) {
    $key = $node->get('field_machine_key')->value;
    if (!isset($features_by_key[$key])) {
      continue;
    }
    $node->set('field_features', $features_by_key[$key]);
    $node->save();
  }
}

/**
 * Adds "Space" field_teaser_features — a short plain-text bullet list for the
 * homepage "Three spaces. One hub." teaser cards, separate from
 * field_features (which now holds the richer icon|Title|Subtitle entries for
 * the /spaces detail cards — the two sections show different, shorter
 * wording on the homepage per the Figma reference).
 */
function cfc_content_update_11008(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_teaser_features')) {
    FieldStorageConfig::create([
      'field_name' => 'field_teaser_features',
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => ['max_length' => 128],
      'cardinality' => FieldStorageConfig::CARDINALITY_UNLIMITED,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'space', 'field_teaser_features')) {
    FieldConfig::create([
      'field_name' => 'field_teaser_features',
      'entity_type' => 'node',
      'bundle' => 'space',
      'label' => 'Teaser features',
      'description' => 'One short line per item. Shown on the homepage "Three spaces. One hub." cards.',
    ])->save();
  }

  $teaser_features_by_key = [
    'desk' => ['Dedicated internet', 'Print on-site', 'Quiet environment'],
    'meeting' => ['6 people · Soundproofed', '4K conferencing', '2h slots'],
    'studio' => ['3 cameras · 3 microphones', 'Integrated lighting', 'Mobile control room'],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($storage->loadByProperties(['type' => 'space']) as $node) {
    $key = $node->get('field_machine_key')->value;
    if (!isset($teaser_features_by_key[$key])) {
      continue;
    }
    $node->set('field_teaser_features', $teaser_features_by_key[$key]);
    $node->save();
  }

  _cfc_content_build_default_displays('space', ['field_teaser_features']);
}

/**
 * Adds "Space" field_meta1_label/value and field_meta2_label/value — the
 * first two columns of the /spaces detail card's bottom meta row (the
 * third column is always "Pricing", from the existing field_price_label).
 * Labels vary per space in the Figma reference (Desk: Slots/Bookings;
 * Meeting Room and Studio: Capacity/Slots), so both are editable per node
 * rather than hardcoded in the template.
 */
function cfc_content_update_11009(): void {
  $fields = [
    'field_meta1_label' => ['type' => 'string', 'label' => 'Meta column 1 — label', 'settings' => ['max_length' => 32]],
    'field_meta1_value' => ['type' => 'string', 'label' => 'Meta column 1 — value', 'settings' => ['max_length' => 64]],
    'field_meta2_label' => ['type' => 'string', 'label' => 'Meta column 2 — label', 'settings' => ['max_length' => 32]],
    'field_meta2_value' => ['type' => 'string', 'label' => 'Meta column 2 — value', 'settings' => ['max_length' => 64]],
  ];
  foreach ($fields as $field_name => $spec) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $spec['type'],
        'settings' => $spec['settings'] ?? [],
        'cardinality' => 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'space', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'space',
        'label' => $spec['label'],
      ])->save();
    }
  }

  $meta_by_key = [
    'desk' => ['Slots', 'Half-day · 2h slots', 'Bookings', 'Unlimited'],
    'meeting' => ['Capacity', '6 people', 'Slots', '2h slots'],
    'studio' => ['Capacity', '1 journalist · 2 guests', 'Slots', 'Half-day max'],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($storage->loadByProperties(['type' => 'space']) as $node) {
    $key = $node->get('field_machine_key')->value;
    if (!isset($meta_by_key[$key])) {
      continue;
    }
    [$label1, $value1, $label2, $value2] = $meta_by_key[$key];
    $node->set('field_meta1_label', $label1);
    $node->set('field_meta1_value', $value1);
    $node->set('field_meta2_label', $label2);
    $node->set('field_meta2_value', $value2);
    $node->save();
  }

  _cfc_content_build_default_displays('space', ['field_meta1_label', 'field_meta1_value', 'field_meta2_label', 'field_meta2_value']);
}

/**
 * Re-seeds the Space cards' subtitle/summary/capacity_meta/price_label to
 * match the booking space-picker text exactly, and makes Studio free
 * (field_price_label + field_hourly_rate) per the confirmed pricing update.
 */
function cfc_content_update_11010(): void {
  $updates = [
    'desk' => [
      'field_subtitle' => 'Co-working · Press lounge',
      'field_summary' => 'Flexible desks reserved for international accredited journalists. Quiet, professional environment with internet, coffee and print.',
      'field_capacity_meta' => 'Half-day slots · 2h minimum',
      'field_price_label' => 'Free',
    ],
    'meeting' => [
      'field_subtitle' => 'Private · Video conferencing',
      'field_summary' => 'Video conferencing room for interviews, editorial meetings and professional exchanges. Seats 6 people.',
      'field_capacity_meta' => '2h slots · 6 people',
      'field_price_label' => 'Free',
    ],
    'studio' => [
      'field_subtitle' => 'Podcast production',
      'field_summary' => 'Professional podcast studio for recording, interviews and content production. 3 cameras, 3 microphones, integrated lighting and technician.',
      'field_capacity_meta' => 'Half-day max · 3 seats',
      'field_price_label' => 'Free',
      'field_hourly_rate' => 0,
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($updates as $key => $values) {
    $nodes = $storage->loadByProperties(['type' => 'space', 'field_machine_key' => $key]);
    $node = reset($nodes);
    if (!$node) {
      continue;
    }
    foreach ($values as $field => $value) {
      $node->set($field, $value);
    }
    $node->save();
  }
}
