/**
 * Creates the "Production" content type and its fields.
 */
function _cfc_content_create_production_type(): void {
  NodeType::create([
    'type' => 'production',
    'name' => 'Production',
    'description' => 'A piece of media content produced at the Hub (interview, report, documentary, podcast).',
  ])->save();

  $fields = [
    'field_production_type' => [
      'type' => 'list_string',
      'label' => 'Type',
      'settings' => [
        'allowed_values' => [
          'Interview' => 'Interview',
          'Report' => 'Report',
          'Documentary' => 'Documentary',
          'Podcast' => 'Podcast',
          'Production' => 'Production',
        ],
      ],
      'cardinality' => 1,
      'required' => TRUE,
    ],
    'field_publisher' => [
      'type' => 'string',
      'label' => 'Publisher',
      'settings' => ['max_length' => 128],
      'cardinality' => 1,
    ],
    'field_duration' => [
      'type' => 'string',
      'label' => 'Duration',
      'settings' => ['max_length' => 32],
      'cardinality' => 1,
      'description' => 'e.g. "24 min".',
    ],
    'field_production_date' => [
      'type' => 'datetime',
      'label' => 'Date',
      'settings' => ['datetime_type' => 'date'],
      'cardinality' => 1,
    ],
    'field_image' => [
      'type' => 'image',
      'label' => 'Image',
      'cardinality' => 1,
    ],
    'field_featured' => [
      'type' => 'boolean',
      'label' => 'Featured',
      'cardinality' => 1,
    ],
    'field_description' => [
      'type' => 'text_long',
      'label' => 'Description',
      'cardinality' => 1,
    ],
  ];

  _cfc_content_create_fields('node', 'production', $fields);
}

/**
 * Adds field_concurrent_capacity to the Space content type and backfills it
 * (Desk = unlimited, Meeting Room / Studio = single occupancy).
 */
function cfc_content_update_11001(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_concurrent_capacity')) {
    FieldStorageConfig::create([
      'field_name' => 'field_concurrent_capacity',
      'entity_type' => 'node',
      'type' => 'integer',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'space', 'field_concurrent_capacity')) {
    FieldConfig::create([
      'field_name' => 'field_concurrent_capacity',
      'entity_type' => 'node',
      'bundle' => 'space',
      'label' => 'Concurrent capacity',
      'required' => TRUE,
      'description' => 'How many simultaneous bookings this space allows for the same time slot. 0 = unlimited (e.g. Desk). 1 = single occupancy (e.g. Meeting Room, Studio).',
    ])->save();
  }

  $capacity_by_key = ['desk' => 0, 'meeting' => 1, 'studio' => 1];
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($storage->loadByProperties(['type' => 'space']) as $node) {
    $key = $node->get('field_machine_key')->value;
    $node->set('field_concurrent_capacity', $capacity_by_key[$key] ?? 1);
    $node->save();
  }
}

/**
 * Adds field_hourly_rate + field_currency to the Space content type, so
 * paid spaces (Studio) have a real numeric amount to charge via Stripe
 * instead of just the display string in field_price_label.
 *
 * Defaults Studio to a placeholder rate in EUR — the client should adjust
 * both the rate and currency from the Space edit form once their Stripe
 * account's settlement currency is confirmed.
 */
function cfc_content_update_11002(): void {
  $fields = [
    'field_hourly_rate' => [
      'type' => 'decimal',
      'label' => 'Hourly rate',
      'settings' => ['precision' => 10, 'scale' => 2],
      'description' => 'Numeric price per hour used to charge online payment. Leave empty (or 0) for free spaces.',
    ],
    'field_currency' => [
      'type' => 'string',
      'label' => 'Currency (ISO code)',
      'settings' => ['max_length' => 3],
      'description' => 'e.g. "EUR", "USD". Must be a currency your Stripe account can accept.',
    ],
  ];

  foreach ($fields as $field_name => $spec) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $spec['type'],
        'settings' => $spec['settings'] ?? [],
        'cardinality' => 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'space', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'space',
        'label' => $spec['label'],
        'description' => $spec['description'] ?? '',
      ])->save();
    }
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($storage->loadByProperties(['type' => 'space']) as $node) {
    $key = $node->get('field_machine_key')->value;
    if ($key === 'studio') {
      // Placeholder rate — adjust from the Space edit form once the Stripe
      // account's currency is confirmed. 400 MAD ≈ 37 EUR at time of writing.
      $node->set('field_hourly_rate', '37.00');
      $node->set('field_currency', 'EUR');
      $node->save();
    }
  }
}

/**
 * Updates booking rules: Desk/Meeting Room drop the "1 hour" slot (2h/4h/8h
 * only), Studio drops both "1 hour" and "Full day" (2h/4h only), and Meeting
 * Room's guest cap changes from 10 to 6. Desk (0 guests) and Studio (2
 * guests) are re-set too, defensively, even though already correct.
 */
function cfc_content_update_11003(): void {
  $durations_by_key = [
    'desk' => ['2 hours', 'Half day (4h)', 'Full day (8h)'],
    'meeting' => ['2 hours', 'Half day (4h)', 'Full day (8h)'],
    'studio' => ['2 hours', 'Half day (4h)'],
  ];
  $max_guests_by_key = [
    'desk' => 0,
    'meeting' => 6,
    'studio' => 2,
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($storage->loadByProperties(['type' => 'space']) as $node) {
    $key = $node->get('field_machine_key')->value;
    if (!isset($durations_by_key[$key])) {
      continue;
    }
    $node->set('field_slot_durations', $durations_by_key[$key]);
    $node->set('field_max_guests', $max_guests_by_key[$key]);
    $node->save();
  }
}

/**
 * Builds the missing entity form + view displays for "space" and
 * "production" — without these, the admin edit form for these nodes only
 * shows the Title field, since our fields were created via code (not the
 * Field UI, which is what normally auto-generates these displays).
 */
function cfc_content_update_11004(): void {
  $space_fields = [
    'field_machine_key', 'field_subtitle', 'field_summary', 'field_price_label',
    'field_capacity_meta', 'field_access_rule', 'field_highlight', 'field_hero_image',
    'field_features', 'field_slot_durations', 'field_max_guests', 'field_cta_label',
    'field_weight', 'field_description', 'field_concurrent_capacity', 'field_hourly_rate',
    'field_currency',
  ];
  $production_fields = [
    'field_production_type', 'field_publisher', 'field_duration', 'field_production_date',
    'field_image', 'field_featured', 'field_description',
  ];

  _cfc_content_build_default_displays('space', $space_fields);
  _cfc_content_build_default_displays('production', $production_fields);
}

/**
 * Creates (or completes) the default form + view display for a bundle,
 * assigning a widget/formatter per field based on its storage type (see
 * CFC_CONTENT_FIELD_DISPLAY_MAP). Safe to re-run: setComponent() overwrites.
 */
function _cfc_content_build_default_displays(string $bundle, array $field_names): void {
  $field_definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', $bundle);
  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('node', $bundle, 'default');
  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('node', $bundle, 'default');

  $weight = 0;
  foreach ($field_names as $field_name) {
    if (!isset($field_definitions[$field_name])) {
      continue;
    }
    $field_type = $field_definitions[$field_name]->getType();
    $map = CFC_CONTENT_FIELD_DISPLAY_MAP[$field_type] ?? NULL;
    if (!$map) {
      continue;
    }
    $form_display->setComponent($field_name, ['type' => $map['widget'], 'weight' => $weight]);
    $view_display->setComponent($field_name, ['type' => $map['formatter'], 'weight' => $weight]);
    $weight++;
  }
  $form_display->save();
  $view_display->save();
}

/**
 * Helper to create field storage + field instances for a bundle.
 */
function _cfc_content_create_fields(string $entity_type, string $bundle, array $fields): void {
  foreach ($fields as $field_name => $spec) {
    if (!FieldStorageConfig::loadByName($entity_type, $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => $entity_type,
        'type' => $spec['type'],
        'settings' => $spec['settings'] ?? [],
        'cardinality' => $spec['cardinality'] ?? 1,
      ])->save();
    }

    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'label' => $spec['label'],
      'required' => $spec['required'] ?? FALSE,
      'description' => $spec['description'] ?? '',
    ])->save();
  }
}
