      ['CFC Monthly Digest — June 2025', '2025-06-01', '12 pages', NULL],
      ['Morocco Economy Update — Q2 2025', '2025-06-01', '6 pages', NULL],
      ['Pan-African Market Briefing — May 2025', '2025-05-01', '10 pages', NULL],
