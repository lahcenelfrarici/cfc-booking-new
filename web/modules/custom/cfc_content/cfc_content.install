<?php

/**
 * @file
 * Install/schema hooks for CFC Content.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;

/**
 * Default widget/formatter per field type — fields created programmatically
 * (via FieldConfig::create(), as this module does throughout) never get an
 * entity form/view display the way Field UI would auto-generate one, so
 * without this the admin edit form only ever shows Title. See
 * _cfc_content_build_default_displays().
 */
const CFC_CONTENT_FIELD_DISPLAY_MAP = [
  'string' => ['widget' => 'string_textfield', 'formatter' => 'string'],
  'string_long' => ['widget' => 'string_textarea', 'formatter' => 'basic_string'],
  'text_long' => ['widget' => 'text_textarea', 'formatter' => 'text_default'],
  'list_string' => ['widget' => 'options_select', 'formatter' => 'list_default'],
  'boolean' => ['widget' => 'boolean_checkbox', 'formatter' => 'boolean'],
  'image' => ['widget' => 'image_image', 'formatter' => 'image'],
  'integer' => ['widget' => 'number', 'formatter' => 'number_integer'],
  'decimal' => ['widget' => 'number', 'formatter' => 'number_decimal'],
  'datetime' => ['widget' => 'datetime_default', 'formatter' => 'datetime_default'],
  'entity_reference' => ['widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label'],
];

/**
 * Implements hook_install().
 */
function cfc_content_install(): void {
  _cfc_content_create_space_type();
  _cfc_content_create_production_type();
}

/**
 * Creates the "Space" content type and its fields.
 */
function _cfc_content_create_space_type(): void {
  NodeType::create([
    'type' => 'space',
    'name' => 'Space',
    'description' => 'A bookable space (Desk, Meeting Room, Studio).',
  ])->save();

  $fields = [
    'field_machine_key' => [
      'type' => 'string',
      'label' => 'Machine key',
      'settings' => ['max_length' => 32],
      'cardinality' => 1,
      'required' => TRUE,
      'description' => 'Stable slug used in URLs/anchors (e.g. "desk", "meeting", "studio").',
    ],
    'field_subtitle' => [
      'type' => 'string',
      'label' => 'Subtitle',
      'settings' => ['max_length' => 128],
      'cardinality' => 1,
    ],
    'field_summary' => [
      'type' => 'string_long',
      'label' => 'Summary',
      'cardinality' => 1,
      'description' => 'Short teaser text used on the homepage card.',
    ],
    'field_price_label' => [
      'type' => 'string',
      'label' => 'Price label',
      'settings' => ['max_length' => 64],
      'cardinality' => 1,
      'description' => 'e.g. "Free" or "400 MAD / hr".',
    ],
    'field_capacity_meta' => [
      'type' => 'string',
      'label' => 'Capacity / slots meta',
      'settings' => ['max_length' => 128],
      'cardinality' => 1,
      'description' => 'e.g. "6 people · 2h slots".',
    ],
    'field_access_rule' => [
      'type' => 'list_string',
      'label' => 'Access rule',
      'settings' => [
        'allowed_values' => [
          'journalist' => 'Journalist only',
          'company' => 'CFC Member only',
          'both' => 'Journalist & CFC Member',
        ],
      ],
      'cardinality' => 1,
      'required' => TRUE,
    ],
    'field_highlight' => [
      'type' => 'boolean',
      'label' => 'Highlight (featured styling)',
      'cardinality' => 1,
    ],
    'field_hero_image' => [
      'type' => 'image',
      'label' => 'Hero image',
      'cardinality' => 1,
    ],
    'field_features' => [
      'type' => 'string',
      'label' => 'Features / includes',
      'settings' => ['max_length' => 255],
      'cardinality' => FieldStorageConfig::CARDINALITY_UNLIMITED,
    ],
    'field_slot_durations' => [
      'type' => 'list_string',
      'label' => 'Available slot durations',
      'settings' => [
        'allowed_values' => [
          '1 hour' => '1 hour',
          '2 hours' => '2 hours',
          'Half day (4h)' => 'Half day (4h)',
          'Full day (8h)' => 'Full day (8h)',
        ],
      ],
      'cardinality' => FieldStorageConfig::CARDINALITY_UNLIMITED,
    ],
    'field_max_guests' => [
      'type' => 'integer',
      'label' => 'Max guests',
      'cardinality' => 1,
    ],
    'field_cta_label' => [
      'type' => 'string',
      'label' => 'Call-to-action label',
      'settings' => ['max_length' => 64],
      'cardinality' => 1,
    ],
    'field_weight' => [
      'type' => 'integer',
      'label' => 'Display order',
      'cardinality' => 1,
    ],
    'field_description' => [
      'type' => 'text_long',
      'label' => 'Description',
      'cardinality' => 1,
    ],
    'field_concurrent_capacity' => [
      'type' => 'integer',
      'label' => 'Concurrent capacity',
      'cardinality' => 1,
      'required' => TRUE,
      'description' => 'How many simultaneous bookings this space allows for the same time slot. 0 = unlimited (e.g. Desk). 1 = single occupancy (e.g. Meeting Room, Studio).',
    ],
    'field_hourly_rate' => [
      'type' => 'decimal',
      'label' => 'Hourly rate',
      'settings' => ['precision' => 10, 'scale' => 2],
      'cardinality' => 1,
      'description' => 'Numeric price per hour used to charge online payment. Leave empty (or 0) for free spaces.',
    ],
    'field_currency' => [
      'type' => 'string',
      'label' => 'Currency (ISO code)',
      'settings' => ['max_length' => 3],
