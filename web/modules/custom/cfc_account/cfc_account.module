<?php

/**
 * @file
 * Hook implementations for CFC Account.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;

/**
 * Shared input styling, matching every other Form API field in this project
 * (AccountRegisterForm::INPUT_CLASSES etc.) — core's UserLoginForm can't be
 * edited directly, so this hook is the only place to apply it.
 */
const CFC_LOGIN_INPUT_CLASSES = ['w-full', 'border', 'border-neutral-200', 'rounded-xl', 'px-4', 'py-3', 'text-[14px]', 'text-neutral-900', 'bg-white', 'focus:outline-none', 'focus:border-[#9F5434]', 'transition-colors'];

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * Two jobs:
 * 1. The sign-in page (and CFC Member registration, which centers on a
 *    "Professional Email Address") invites people to log in with their
 *    "Username or email" — but Drupal core's login form only ever
 *    authenticates by username. This resolves a submitted value that looks
 *    like a registered email address back to its account username before
 *    core's own authentication validation runs, so email actually works.
 * 2. Restyles the two fields to match the site design and adds the
 *    "Forgot password?" link + show/hide toggle inline — sign-in-page.twig
 *    now renders this real form object (not a hand-copied markup
 *    reconstruction), so a failed login re-displays correctly inside our
 *    themed page instead of falling through to core's unstyled
 *    /user/login error page.
 */
function cfc_account_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  array_unshift($form['#validate'], 'cfc_account_user_login_resolve_email');

  $form['#attributes']['class'][] = 'space-y-4';
  $form['#attributes']['x-data'] = '{ showPassword: false }';

  $form['name']['#title'] = t('Username or email');
  $form['name']['#attributes']['class'] = CFC_LOGIN_INPUT_CLASSES;
  $form['name']['#attributes']['placeholder'] = 'you@media.org';
  unset($form['name']['#description']);

  // Password field: the "Forgot password?" link sits inline with the label
  // (same row, space-between), and the input needs the show/hide eye
  // button — neither fits Drupal's default #title+#description rendering,
  // so both are replaced with hand-built markup matching the rest of the
  // field's structure exactly.
  $forgot_url = Url::fromRoute('cfc_pages.forgot_password')->toString();
  $form['pass']['#title_display'] = 'invisible';
  $form['pass']['#attributes']['class'] = array_merge(CFC_LOGIN_INPUT_CLASSES, ['pr-11']);
  $form['pass']['#attributes']['placeholder'] = '••••••••';
  $form['pass']['#attributes'][':type'] = "showPassword ? 'text' : 'password'";
  unset($form['pass']['#description']);
  $form['pass']['#prefix'] = Markup::create(<<<HTML
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[12px] text-neutral-600 uppercase tracking-wide font-semibold">Password</span>
      <a href="{$forgot_url}" class="text-[12px] text-[#9F5434] hover:underline underline-offset-2 transition-colors font-medium">Forgot password?</a>
    </div>
    <div class="relative">
    HTML);
  $form['pass']['#suffix'] = Markup::create(<<<'HTML'
    <button type="button" x-on:click="showPassword = !showPassword" tabindex="-1" class="absolute right-4 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-600 transition-colors">
      <span x-show="!showPassword" class="inline-flex"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg></span>
      <span x-show="showPassword" x-cloak class="inline-flex"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" /><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" /><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" /><path d="m2 2 20 20" /></svg></span>
    </button>
    </div>
    HTML);

  $form['actions']['submit']['#value'] = t('Sign in');
  $form['actions']['submit']['#attributes']['class'] = ['w-full', 'bg-[#9F5434]', 'hover:bg-[#8A4A2E]', 'text-white', 'py-3.5', 'rounded-2xl', 'flex', 'items-center', 'justify-center', 'gap-2', 'transition-colors', 'mt-2', 'font-semibold', 'text-[14px]'];
}

/**
 * Form validate callback: resolves an email address to its username.
 */
function cfc_account_user_login_resolve_email(array &$form, FormStateInterface $form_state): void {
  $name = trim((string) $form_state->getValue('name'));
  if ($name === '' || !str_contains($name, '@')) {
    return;
  }
  $account = user_load_by_mail($name);
  if ($account) {
    $form_state->setValue('name', $account->getAccountName());
  }
}

/**
 * Implements hook_mail().
 *
 * Two keys: the "forgot password" 6-digit code (ForgotPasswordRequestForm)
 * and the post-registration "verify your email" 6-digit code
 * (AccountRegisterForm / VerifyEmailForm).
 */
function cfc_account_mail(string $key, array &$message, array $params): void {
  if ($key === 'reset_code') {
    $message['subject'] = t('Your CFC Media Hub verification code');
    $message['body'][] = t('Your verification code is: @code', ['@code' => $params['code']]);
    $message['body'][] = t('This code expires in @minutes minutes. If you did not request a password reset, you can safely ignore this email.', ['@minutes' => $params['minutes']]);
    return;
  }
  if ($key === 'verify_code') {
    $message['subject'] = t('Welcome to CFC Media Hub — verify your email');
    $message['body'][] = t('Thanks for creating your CFC Media Hub account. Your verification code is: @code', ['@code' => $params['code']]);
    $message['body'][] = t('This code expires in @minutes minutes. Enter it on the verification page to finish setting up your account.', ['@minutes' => $params['minutes']]);
  }
}
