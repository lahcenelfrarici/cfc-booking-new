/**
 * Helper to create field storage + field instances on the "booking" bundle.
 */
function _cfc_booking_create_fields(array $fields): void {
  foreach ($fields as $field_name => $spec) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $spec['type'],
        'settings' => $spec['settings'] ?? [],
        'cardinality' => $spec['cardinality'] ?? 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'booking', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'booking',
        'label' => $spec['label'],
        'required' => $spec['required'] ?? FALSE,
        'description' => $spec['description'] ?? '',
      ])->save();
    }
  }
}

/**
 * Switches field_closure_space's widget from "entity_reference_autocomplete"
 * to "options_select" — the autocomplete widget's massageFormValues() only
 * understands a "Label (id)" string or a bare numeric id; it has no concept
 * of a clean "no entity referenced" submission, so the admin picker's "All
 * spaces" card (which needs to submit exactly that) kept failing entity
 * validation ("primitive type" / "referenced entity does not exist")
 * depending on what sentinel was tried. OptionsSelectWidget — already used
 * for field_closure_duration's "- None -" option on this same bundle —
 * handles an empty/"_none" selection correctly out of the box for entity
 * reference fields too (it is a generic "field with a finite list of
 * values" widget, not specific to list_* field types).
 */
function cfc_booking_update_11007(): void {
  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('node', 'closure', 'default');
  $form_display->setComponent('field_closure_space', ['type' => 'options_select', 'weight' => -10]);
  $form_display->save();
}

/**
 * Restricts field_closure_space's selection handler to the "space" bundle
 * — it had no target_bundles restriction at all, so OptionsSelectWidget's
 * getReferenceableEntities() (now in play since cfc_booking_update_11007())
 * built its #options from every node on the site, and a real Space's nid
 * wasn't guaranteed to land in whatever that list produced, causing
 * "the submitted value is not allowed" on save.
 */
function cfc_booking_update_11008(): void {
  $field_config = \Drupal\field\Entity\FieldConfig::loadByName('node', 'closure', 'field_closure_space');
  $field_config->setSetting('handler_settings', ['target_bundles' => ['space' => 'space']]);
  $field_config->save();
}
