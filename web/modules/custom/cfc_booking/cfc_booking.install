<?php

/**
 * @file
 * Install hooks for CFC Booking: the "booking" content type.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;

/**
 * Implements hook_install().
 */
function cfc_booking_install(): void {
  NodeType::create([
    'type' => 'booking',
    'name' => 'Booking',
    'description' => 'A space reservation made by a journalist or CFC member.',
  ])->save();

  _cfc_booking_create_fields(_cfc_booking_field_definitions());
}

/**
 * Adds the Stripe-related fields (real numeric amount, currency, and the
 * PaymentIntent ID for webhook reconciliation) to the Booking content type.
 */
function cfc_booking_update_11001(): void {
  _cfc_booking_create_fields([
    'field_amount' => [
      'type' => 'decimal',
      'label' => 'Amount',
      'settings' => ['precision' => 10, 'scale' => 2],
      'description' => 'Real numeric amount charged (snapshot of the Space hourly rate × duration). Empty for free bookings.',
    ],
    'field_currency' => [
      'type' => 'string',
      'label' => 'Currency (ISO code)',
      'settings' => ['max_length' => 3],
    ],
    'field_stripe_payment_intent' => [
      'type' => 'string',
      'label' => 'Stripe PaymentIntent ID',
      'settings' => ['max_length' => 64],
      'description' => 'Used to reconcile the Stripe webhook with this booking.',
    ],
  ]);
}

/**
 * Installs the "Bookings" admin view (/admin/content/bookings) — config
 * shipped in config/install isn't auto-picked-up on module *update* (only
 * fresh install), so it's loaded and saved programmatically here.
 */
function cfc_booking_update_11002(): void {
  if (\Drupal::entityTypeManager()->getStorage('view')->load('cfc_bookings')) {
    return;
  }
  $module_path = \Drupal::service('extension.list.module')->getPath('cfc_booking');
  $data = \Drupal\Component\Serialization\Yaml::decode(
    file_get_contents($module_path . '/config/install/views.view.cfc_bookings.yml')
  );
  \Drupal::entityTypeManager()->getStorage('view')->create($data)->save();
}

/**
 * Builds the missing entity form + view display for "booking" — without
 * this, the admin edit form only shows the Title field, since our fields
 * were created via code (not the Field UI, which is what normally
 * auto-generates these displays). Same fix as cfc_content_update_11004,
 * for the "space"/"production" bundles.
 */
function cfc_booking_update_11003(): void {
  $display_map = [
    'string' => ['widget' => 'string_textfield', 'formatter' => 'string'],
    'list_string' => ['widget' => 'options_select', 'formatter' => 'list_default'],
    'decimal' => ['widget' => 'number', 'formatter' => 'number_decimal'],
    'datetime' => ['widget' => 'datetime_default', 'formatter' => 'datetime_default'],
    'entity_reference' => ['widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label'],
  ];

  // _cfc_booking_field_definitions() only covers the original field set —
  // field_amount/field_currency/field_stripe_payment_intent were added
  // later by cfc_booking_update_11001() and aren't in it.
  $field_names = array_merge(
    array_keys(_cfc_booking_field_definitions()),
    ['field_amount', 'field_currency', 'field_stripe_payment_intent']
  );
  $field_definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'booking');
  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('node', 'booking', 'default');
  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('node', 'booking', 'default');

  $weight = 0;
  foreach ($field_names as $field_name) {
    if (!isset($field_definitions[$field_name])) {
      continue;
    }
    $map = $display_map[$field_definitions[$field_name]->getType()] ?? NULL;
    if (!$map) {
      continue;
    }
    $form_display->setComponent($field_name, ['type' => $map['widget'], 'weight' => $weight]);
    $view_display->setComponent($field_name, ['type' => $map['formatter'], 'weight' => $weight]);
    $weight++;
  }
  $form_display->save();
  $view_display->save();
}

/**
 * Adds an "Account type" column to the Bookings admin view (/admin/content/
 * bookings), showing the booker's field_account_type (Journalist / CFC
 * Member Company) via the view's existing uid relationship — same approach
 * as the "Reserved by" column, so it's visible without opening each user's
 * profile.
 */
function cfc_booking_update_11004(): void {
  $view = \Drupal::entityTypeManager()->getStorage('view')->load('cfc_bookings');
  if (!$view) {
    return;
  }
  $module_path = \Drupal::service('extension.list.module')->getPath('cfc_booking');
  $data = \Drupal\Component\Serialization\Yaml::decode(
    file_get_contents($module_path . '/config/install/views.view.cfc_bookings.yml')
  );
  $view->set('display', $data['display']);
  $view->save();
}

/**
 * Adds field_booker_account_type to the "booking" bundle, and backfills it
 * on existing bookings from each booking's owner — so spaces shared by both
 * account types (Studio) can keep per-type availability pools going
 * forward without losing track of who already holds which slot.
 */
function cfc_booking_update_11005(): void {
  _cfc_booking_create_fields([
    'field_booker_account_type' => _cfc_booking_field_definitions()['field_booker_account_type'],
  ]);

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $bookings = $storage->loadByProperties(['type' => 'booking']);
  foreach ($bookings as $booking) {
    $owner = $booking->getOwner();
    $account_type = $owner?->hasField('field_account_type') ? $owner->get('field_account_type')->value : NULL;
    if ($account_type) {
      $booking->set('field_booker_account_type', $account_type);
      $booking->save();
    }
  }
}

/**
 * Adds the "Closure" content type: lets an admin manually block a whole day
 * or a single time slot (optionally scoped to one Space — left empty, it
 * blocks every Space) from being booked, e.g. for a public holiday or
 * maintenance window. AvailabilityChecker::closedRanges() reads these and
 * folds them into isFree()/buildMatrix()/findNextAvailable() so the public
 * calendar, the admin booking picker and server-side validation all honour
 * closures the same way they already honour existing bookings.
 */
function cfc_booking_update_11006(): void {
  if (!\Drupal::entityTypeManager()->getStorage('node_type')->load('closure')) {
    \Drupal\node\Entity\NodeType::create([
      'type' => 'closure',
      'name' => 'Closure',
      'description' => 'Blocks a day or time slot from being booked — a public holiday, maintenance window, etc. Leave Space empty to close every space.',
    ])->save();
  }

  $fields = [
    'field_closure_date' => [
      'type' => 'datetime',
      'label' => 'Date',
      'settings' => ['datetime_type' => 'date'],
      'cardinality' => 1,
      'required' => TRUE,
    ],
    'field_closure_space' => [
      'type' => 'entity_reference',
      'label' => 'Space (leave empty to close every space)',
      'settings' => ['target_type' => 'node'],
      'cardinality' => 1,
      'required' => FALSE,
    ],
    'field_full_day' => [
      'type' => 'boolean',
      'label' => 'Close the full day',
      'cardinality' => 1,
      'required' => TRUE,
      'description' => 'If unchecked, fill in Time slot + Duration below to close only part of the day.',
    ],
    'field_closure_time_slot' => [
      'type' => 'string',
      'label' => 'Time slot',
      'settings' => ['max_length' => 16],
      'cardinality' => 1,
      'required' => FALSE,
      'description' => 'e.g. "14:00". Only used when "Close the full day" is unchecked.',
    ],
    'field_closure_duration' => [
      'type' => 'list_string',
      'label' => 'Duration',
      'settings' => [
        'allowed_values' => [
          '1 hour' => '1 hour',
          '2 hours' => '2 hours',
          'Half day (4h)' => 'Half day (4h)',
          'Full day (8h)' => 'Full day (8h)',
        ],
      ],
      'cardinality' => 1,
      'required' => FALSE,
    ],
    'field_closure_reason' => [
      'type' => 'string',
      'label' => 'Reason',
      'settings' => ['max_length' => 256],
      'cardinality' => 1,
      'required' => FALSE,
      'description' => 'Internal note only, e.g. "Public holiday" or "HVAC maintenance".',
    ],
  ];

  foreach ($fields as $field_name => $spec) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $spec['type'],
        'settings' => $spec['settings'] ?? [],
        'cardinality' => $spec['cardinality'] ?? 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'closure', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'closure',
        'label' => $spec['label'],
        'required' => $spec['required'] ?? FALSE,
        'description' => $spec['description'] ?? '',
      ])->save();
    }
  }

  $display_map = [
    'datetime' => ['widget' => 'datetime_default', 'formatter' => 'datetime_default'],
    'entity_reference' => ['widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label'],
    'boolean' => ['widget' => 'boolean_checkbox', 'formatter' => 'boolean'],
    'string' => ['widget' => 'string_textfield', 'formatter' => 'string'],
    'list_string' => ['widget' => 'options_select', 'formatter' => 'list_default'],
  ];
  $field_definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'closure');
  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('node', 'closure', 'default');
  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('node', 'closure', 'default');

  $weight = 0;
  foreach (array_keys($fields) as $field_name) {
    if (!isset($field_definitions[$field_name])) {
      continue;
    }
    $map = $display_map[$field_definitions[$field_name]->getType()] ?? NULL;
    if (!$map) {
      continue;
    }
    $form_display->setComponent($field_name, ['type' => $map['widget'], 'weight' => $weight]);
    $view_display->setComponent($field_name, ['type' => $map['formatter'], 'weight' => $weight]);
    $weight++;
  }
  $form_display->save();
  $view_display->save();
}

