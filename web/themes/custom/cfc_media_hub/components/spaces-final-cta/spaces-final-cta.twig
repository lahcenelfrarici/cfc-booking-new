<section class="bg-neutral-950 text-white py-10 md:py-14 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>
  <div class="relative max-w-[1440px] mx-auto px-5 md:px-12 flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
    <div class="max-w-[640px]">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-5 h-[2px] bg-[#9F5434]"></div>
        <div class="text-[12px] uppercase tracking-[0.18em] text-[#9F5434] font-semibold">Ready to book</div>
      </div>
      <h2 class="tracking-tight leading-[1.1] lg:leading-[1.04] text-[34px] md:text-[60px] font-semibold lg:tracking-[-0.03em]">Ready to book?</h2>
      <p class="mt-4 md:mt-5 text-white/80 leading-relaxed max-w-[480px] text-[15px] md:text-[17px]">Check availability and reserve your space in just a few steps.</p>
    </div>
    {% embed 'cfc_media_hub:button' with { variant: 'white', size: 'md', href: booking_base_url } %}
      {% block icon %}{% include 'cfc_media_hub:icon' with { name: 'calendar', size: 'w-4 h-4' } only %}{% endblock %}
      {% block label %}Check availability{% endblock %}
    {% endembed %}
  </div>
</section>
