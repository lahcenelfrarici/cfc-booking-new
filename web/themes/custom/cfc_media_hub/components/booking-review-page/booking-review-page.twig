<div class="border-b border-neutral-100 bg-white">
  <div class="w-full max-w-[1440px] mx-auto px-5 md:px-12 h-16 md:h-20 flex items-center justify-between gap-3">
    <a href="{{ home_url }}" class="flex items-center gap-2 text-[13px] text-neutral-500 hover:text-neutral-900 transition-colors shrink-0">
      {% include 'cfc_media_hub:icon' with { name: 'arrow-left', size: 'w-4 h-4' } only %}
      <span class="hidden sm:inline">Back</span>
    </a>
    {% include 'cfc_media_hub:journey-steps' with { active: [4] } only %}
    <a href="{{ home_url }}" class="text-[13px] text-neutral-400 hover:text-neutral-700 transition-colors shrink-0">Cancel</a>
  </div>
</div>

<section class="bg-[#FCFCFB] min-h-[70vh]">
  <div class="max-w-[640px] mx-auto px-5 md:px-12 py-8 md:py-16">
    <div class="mb-6 md:mb-10">
      <div class="text-[12px] uppercase tracking-[0.18em] text-[#0F6E56] font-semibold mb-3">Step 4 · Review your reservation</div>
      <h1 class="tracking-tight text-[30px] md:text-[48px] font-semibold tracking-[-0.025em]">
        Review &amp; confirm.
      </h1>
    </div>

    <div class="bg-white rounded-2xl md:rounded-3xl border border-neutral-200 overflow-hidden mb-6">
      <div class="px-5 md:px-8 py-5 bg-[#9F5434]/5 border-b border-neutral-100">
        <div class="text-[12px] uppercase tracking-wide text-[#9F5434] font-semibold">Reservation summary</div>
      </div>
      <div class="divide-y divide-neutral-100">
        <div class="px-5 md:px-8 py-4 flex items-center justify-between gap-3">
          <div class="text-[13px] text-neutral-400 font-medium shrink-0">Space</div>
          <div class="text-[14px] text-neutral-900 font-medium text-right">{{ space_label }}</div>
        </div>
        <div class="px-5 md:px-8 py-4 flex items-center justify-between gap-3">
          <div class="text-[13px] text-neutral-400 font-medium shrink-0">Date</div>
          <div class="text-[14px] text-neutral-900 font-medium text-right">{{ date }}</div>
        </div>
        <div class="px-5 md:px-8 py-4 flex items-center justify-between gap-3">
          <div class="text-[13px] text-neutral-400 font-medium shrink-0">Time</div>
          <div class="text-[14px] text-neutral-900 font-medium text-right">{{ time }} &middot; {{ duration }}</div>
        </div>
        <div class="px-5 md:px-8 py-4 flex items-center justify-between gap-3">
          <div class="text-[13px] text-neutral-400 font-medium shrink-0">Name</div>
          <div class="text-[14px] text-neutral-900 font-medium text-right">{{ user_name }}</div>
        </div>
        <div class="px-5 md:px-8 py-4 flex items-center justify-between gap-3">
          <div class="text-[13px] text-neutral-400 font-medium shrink-0">Account type</div>
          <div class="text-[14px] text-neutral-900 font-medium text-right">{{ account_type_label }}</div>
        </div>
        <div class="px-5 md:px-8 py-4 flex items-center justify-between gap-3">
          <div class="text-[13px] text-neutral-400 font-medium shrink-0">Reference</div>
          <div class="text-[14px] text-neutral-900 font-medium text-right">{{ reference }}</div>
        </div>
        <div class="px-5 md:px-8 py-4 flex items-center justify-between gap-3">
          <div class="text-[13px] text-neutral-400 font-medium shrink-0">Pricing</div>
          <div class="text-[14px] text-[#9F5434] font-bold text-right">{{ price_label }}</div>
        </div>
      </div>
    </div>

    {% if max_guests > 0 %}
      <div class="bg-white rounded-2xl md:rounded-3xl border border-neutral-200 p-5 md:p-8 mb-6">
        {{ guests_form }}
      </div>
    {% endif %}

    <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-4">
      <a href="{{ edit_url }}" class="text-[13px] text-neutral-400 hover:text-red-500 underline underline-offset-2 transition-colors text-center sm:text-left">
        Edit reservation
      </a>
      <a href="{{ confirm_url }}" class="bg-[#9F5434] hover:bg-[#8A4A2E] text-white py-3.5 px-8 rounded-2xl flex items-center justify-center gap-2 transition-colors font-semibold text-[14px]">
        {{ confirm_label }}
        {% include 'cfc_media_hub:icon' with { name: 'arrow-right', size: 'w-4 h-4' } only %}
      </a>
    </div>
  </div>
</section>
