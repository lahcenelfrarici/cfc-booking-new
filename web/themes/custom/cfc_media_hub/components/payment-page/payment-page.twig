<div class="border-b border-neutral-100 bg-white">
  <div class="w-full max-w-[1440px] mx-auto px-12 h-20 flex items-center justify-between">
    <a href="{{ home_url }}" class="flex items-center gap-2 text-[13px] text-neutral-500 hover:text-neutral-900 transition-colors">
      {% include 'cfc_media_hub:icon' with { name: 'arrow-left', size: 'w-4 h-4' } only %}
      Back
    </a>
    {% include 'cfc_media_hub:journey-steps' with { active: [5] } only %}
    <a href="{{ home_url }}" class="text-[13px] text-neutral-400 hover:text-neutral-700 transition-colors">Cancel</a>
  </div>
</div>

<section class="bg-[#FCFCFB] min-h-[70vh]">
  <div class="max-w-[960px] mx-auto px-12 py-16">
    <div class="mb-10">
      <div class="text-[12px] uppercase tracking-[0.18em] text-[#0F6E56] font-semibold mb-3">Step 5 · Payment</div>
      <h1 class="tracking-tight" style="font-size: 48px; font-weight: 600; letter-spacing: -0.025em;">
        Complete your booking.
      </h1>
    </div>

    <div class="grid grid-cols-12 gap-8">
      <div class="col-span-5">
        <div class="bg-white rounded-3xl border border-neutral-200 overflow-hidden sticky top-28">
          <div class="px-7 py-5 bg-[#9F5434]/5 border-b border-neutral-100">
            <div class="text-[12px] uppercase tracking-wide text-[#9F5434] font-semibold">Reservation summary</div>
          </div>
          <div class="p-7 space-y-4">
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-neutral-400">Space</div>
              <div class="text-[14px] text-neutral-900 font-medium">{{ space_label }}</div>
            </div>
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-neutral-400">Date</div>
              <div class="text-[14px] text-neutral-900 font-medium">{{ date }}</div>
            </div>
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-neutral-400">Time</div>
              <div class="text-[14px] text-neutral-900 font-medium">{{ time }}</div>
            </div>
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-neutral-400">Duration</div>
              <div class="text-[14px] text-neutral-900 font-medium">{{ duration }}</div>
            </div>
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-neutral-400">Name</div>
              <div class="text-[14px] text-neutral-900 font-medium">{{ user_name }}</div>
            </div>
            {% for guest in guest_names %}
              <div class="flex items-center justify-between">
                <div class="text-[13px] text-neutral-400">Guest {{ loop.index }}</div>
                <div class="text-[14px] text-neutral-900 font-medium">{{ guest }}</div>
              </div>
            {% endfor %}
            <div class="border-t border-neutral-100 pt-4 mt-4">
              <div class="flex items-center justify-between">
                <div class="text-[13px] text-neutral-400">Total</div>
                <div class="text-[14px] text-[#9F5434] font-bold">{{ total_label }}</div>
              </div>
            </div>
            <div class="text-[11px] text-neutral-400 pt-2">
              Ref: {{ reference }}
            </div>
          </div>
        </div>
      </div>

      <div class="col-span-7">
        <div class="cfc-form-shell">
          {{ form }}
        </div>
      </div>
    </div>
  </div>
</section>
