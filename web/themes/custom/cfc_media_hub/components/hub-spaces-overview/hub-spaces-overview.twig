{% set icon_by_key = { desk: 'briefcase', meeting: 'users', studio: 'mic' } %}
{% set tag_by_access = {
  journalist: 'International accredited journalists only',
  company: 'CFC Member companies only',
  both: 'International Accredited Journalists & CFC Members',
} %}

<section class="bg-[#FCFCFB] py-20 border-t border-b border-[#9F5434]/10">
  <div class="max-w-[1440px] mx-auto px-12">
    <div class="flex items-end justify-between mb-12">
      <div class="max-w-[680px]">
        <div class="flex items-center gap-2 text-[12px] uppercase tracking-[0.18em] mb-4">
          <span class="text-[#9F5434] font-bold">03</span>
          <span class="text-[#9F5434] font-semibold">&middot; The spaces</span>
        </div>
        <h2 class="tracking-tight text-neutral-900 mb-5" style="font-size: 48px; font-weight: 600; line-height: 1.05; letter-spacing: -0.025em;">
          Three complementary spaces, one workflow.
        </h2>
        <p class="text-neutral-600 leading-relaxed text-[16px]">
          The hub offers three complementary spaces designed for different needs — from quiet writing to podcast production.
        </p>
      </div>
      <a href="{{ spaces_url }}" class="flex items-center gap-2 border border-neutral-300 hover:border-[#9F5434] hover:text-[#9F5434] hover:bg-white transition-colors px-6 py-3 rounded-xl text-[13px] font-medium">
        View all spaces
        {% include 'cfc_media_hub:icon' with { name: 'arrow-right', size: 'w-4 h-4' } only %}
      </a>
    </div>

    <div class="grid grid-cols-3 gap-5">
      {% for s in spaces %}
        <div class="flex flex-col bg-white border border-neutral-200/70 rounded-2xl p-8 hover:border-[#9F5434]/40 hover:-translate-y-0.5 transition-all">
          <div class="flex items-center justify-between mb-8">
            <div class="w-11 h-11 rounded-xl bg-[#9F5434]/10 text-[#9F5434] flex items-center justify-center">
              {% include 'cfc_media_hub:icon' with { name: icon_by_key[s.id] ?? 'briefcase', size: 'w-4 h-4' } only %}
            </div>
            <span class="text-[11px] text-[#9F5434] font-semibold">0{{ loop.index }}</span>
          </div>
          <h3 class="tracking-tight mb-2" style="font-size: 26px; font-weight: 600; letter-spacing: -0.02em;">{{ s.title }}</h3>
          <p class="text-neutral-600 leading-relaxed text-[14px]">{{ s.summary }}</p>
          <div class="mt-6 flex items-center justify-between pt-5 border-t border-neutral-100">
            <span class="text-[11px] px-2.5 py-1 rounded-full font-semibold {{ s.access_rule == 'both' ? 'bg-[#9F5434] text-white' : 'bg-neutral-100 text-neutral-600' }}">
              {{ tag_by_access[s.access_rule] }}
            </span>
            <a href="{{ spaces_url }}#space-{{ s.id }}" class="text-[#0F6E56] text-[13px] flex items-center gap-1 group font-semibold">
              Learn more
              {% include 'cfc_media_hub:icon' with { name: 'arrow-up-right', size: 'w-3.5 h-3.5', class: 'group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform' } only %}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
