<section class="bg-[#0F6E56] text-white py-16 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>
  <div class="relative max-w-[1440px] mx-auto px-12 flex items-center justify-between gap-12">
    <div class="max-w-[640px]">
      <div class="flex items-center gap-2 text-[12px] uppercase tracking-[0.18em] mb-4">
        <span class="text-[#9F5434]/80 font-bold">05</span>
        <span class="text-[#9F5434]/80 font-semibold">&middot; Get started</span>
      </div>
      <h2 class="tracking-tight" style="font-size: 60px; font-weight: 600; line-height: 1.04; letter-spacing: -0.03em;">Start using the hub.</h2>
      <p class="mt-5 text-white/80 leading-relaxed max-w-[460px] text-[17px]">Explore available spaces and book your session in seconds.</p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      {% embed 'cfc_media_hub:button' with { variant: 'white', size: 'md', href: booking_base_url } %}
        {% block icon %}{% include 'cfc_media_hub:icon' with { name: 'calendar', size: 'w-4 h-4' } only %}{% endblock %}
        {% block label %}Check availability{% endblock %}
      {% endembed %}
      <a href="mailto:mediahub@cfcma.com" class="border border-[#9F5434]/60 hover:bg-[#9F5434]/15 transition-colors text-white px-7 py-4 rounded-xl text-[14px] font-medium">
        Contact Us
      </a>
    </div>
  </div>
</section>
