<section class="relative bg-white pt-16 pb-24 overflow-hidden">
  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-bl from-[#9F5434]/5 to-transparent pointer-events-none"></div>
  <div class="relative max-w-[1440px] mx-auto px-12">
    <div class="flex items-center gap-2 text-[12px] text-neutral-500 mb-10">
      <a href="{{ home_url }}" class="hover:text-neutral-900 transition-colors">Home</a>
      <span>/</span>
      <span class="text-neutral-900">The Hub</span>
    </div>

    <div class="grid grid-cols-12 gap-12 items-end">
      <div class="col-span-7">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-5 h-[2px] bg-[#9F5434]"></div>
          <div class="text-[12px] uppercase tracking-[0.18em] text-[#9F5434] font-semibold">The Hub &middot; Casablanca</div>
        </div>
        <h1 class="tracking-tight text-neutral-900" style="font-size: 78px; font-weight: 600; line-height: 1.04; letter-spacing: -0.03em;">
          A dedicated hub for international media.
        </h1>
      </div>
      <div class="col-span-5 pb-3">
        <p class="text-neutral-700 leading-relaxed text-[18px]">
          Located in Casablanca Finance City, the CFC Media Hub provides international press correspondents with a professional environment to create, collaborate and produce.
        </p>
        <p class="mt-5 text-neutral-500 leading-relaxed text-[14px]">
          From fully equipped workspaces to a state-of-the-art podcast studio, the hub is designed to support media production at every stage.
        </p>
        <div class="mt-8 flex items-center gap-4">
          {% embed 'cfc_media_hub:button' with { variant: 'terracotta', size: 'sm', href: spaces_url } %}
            {% block label %}Explore spaces{% endblock %}
            {% block icon %}{% include 'cfc_media_hub:icon' with { name: 'arrow-right', size: 'w-4 h-4' } only %}{% endblock %}
          {% endembed %}
        </div>
      </div>
    </div>

    <div class="mt-16 rounded-2xl overflow-hidden h-[460px] relative">
      <img src="{{ images_base }}/hub-lobby.jpg" alt="CFC Media Hub interior" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
      <div class="absolute bottom-7 left-7 right-7 flex items-end justify-between text-white">
        <div>
          <div class="text-[11px] uppercase tracking-[0.18em] text-white/80 mb-1.5">CFC Cube &middot; 2nd Floor &middot; Main Street</div>
          <div class="tracking-tight" style="font-size: 22px; font-weight: 500; letter-spacing: -0.01em;">Located in Casablanca Finance City</div>
        </div>
        <div class="flex items-center gap-8 text-[12px] text-white/85">
          <div><span class="text-white/55">Open</span> &middot; 8:30 am to 6:00 pm</div>
          <div><span class="text-white/55">Operated by</span> &middot; CFC Authority</div>
        </div>
      </div>
    </div>
  </div>
</section>
