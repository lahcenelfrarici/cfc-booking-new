{% set variant_classes = {
  'terracotta': 'btn-premium bg-[#9F5434] hover:bg-[#8A4A2E] text-white',
  'outline-dark': 'border border-neutral-900/15 hover:border-[#9F5434]/50 hover:text-[#9F5434] text-neutral-900 backdrop-blur-sm',
  'outline-white': 'border border-white/25 hover:bg-white/10 text-white backdrop-blur-sm',
  'white': 'bg-white text-[#0F6E56] hover:bg-[#E1F5EE] shadow-[0_8px_24px_-8px_rgba(0,0,0,0.25)]',
} %}
{% set size_classes = {
  'sm': 'px-5 py-2.5 rounded-full text-[13px] font-semibold',
  'md': 'px-8 py-4 rounded-full text-[14px] font-semibold',
} %}
{% set classes = 'inline-flex items-center justify-center gap-2 transition-colors group ' ~ variant_classes[variant|default('terracotta')] ~ ' ' ~ size_classes[size|default('md')] %}

{% set inner %}
  {% block label %}{% endblock %}
  {% if block('icon') is defined and block('icon')|trim %}{% block icon %}{% endblock %}{% endif %}
{% endset %}

{% if href %}
  <a href="{{ href }}"{{ attributes.addClass(classes) }}>{{ inner }}</a>
{% else %}
  <button type="button"{{ attributes.addClass(classes) }}>{{ inner }}</button>
{% endif %}
