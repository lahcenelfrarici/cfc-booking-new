<div x-show="open" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center p-6">
  <div class="absolute inset-0 bg-black/50" x-on:click="open = false"></div>

  <div class="relative bg-white rounded-2xl shadow-2xl max-w-[560px] w-full max-h-[90vh] overflow-y-auto">
    <div class="px-8 pt-8 pb-6 border-b border-neutral-100 flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-4 h-[2px] bg-[#9F5434]"></div>
          <div class="text-[11px] uppercase tracking-[0.16em] text-[#9F5434] font-semibold">Connection request</div>
        </div>
        <h2 class="text-neutral-900 tracking-tight mb-1.5" style="font-size: 24px; font-weight: 600;">Request a connection.</h2>
        <p class="text-neutral-500 text-[14px]">Our team will coordinate on your behalf.</p>
      </div>
      <button type="button" x-on:click="open = false" class="shrink-0 w-9 h-9 rounded-full bg-neutral-100 hover:bg-neutral-200 text-neutral-500 flex items-center justify-center transition-colors">
        {% include 'cfc_media_hub:icon' with { name: 'x', size: 'w-4 h-4' } only %}
      </button>
    </div>

    {{ connection_form }}
  </div>
</div>
