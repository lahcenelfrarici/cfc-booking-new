{% set icon_by_key = { desk: 'wifi', meeting: 'users', studio: null } %}
{% set tag_by_access = { journalist: 'Accredited access', company: 'CFC Members only', both: null } %}

<section class="bg-[#FCFCFB] py-20">
  <div class="max-w-[1440px] mx-auto px-12">
    <div class="flex items-end justify-between mb-14">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-5 h-[2px] bg-[#9F5434]"></div>
          <div class="text-[12px] uppercase tracking-[0.18em] text-[#0F6E56] font-semibold">Spaces</div>
        </div>
        <h2 class="text-neutral-900 tracking-tight max-w-[680px]" style="font-size: 56px; font-weight: 600; line-height: 1.05; letter-spacing: -0.025em;">
          Three spaces. <span class="text-neutral-400">One hub.</span>
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-6">
      {% for s in spaces %}
        {% set tag = tag_by_access[s.access_rule] ?? null %}
        {% set icon = icon_by_key[s.id] ?? null %}
        <article class="group relative rounded-2xl overflow-hidden border transition-all hover:-translate-y-1 {{ s.highlight ? 'border-[#0F6E56] bg-[#0F6E56] text-white shadow-[0_30px_80px_-30px_rgba(15,110,86,0.5)]' : 'border-neutral-200 bg-white hover:border-[#9F5434]/30 hover:shadow-[0_20px_50px_-20px_rgba(159,84,52,0.1)]' }}">
          <a href="{{ spaces_url }}#space-{{ s.id }}" class="relative h-56 overflow-hidden block bg-neutral-100">
            {% if s.image_url %}
              <img src="{{ s.image_url }}" alt="{{ s.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            {% endif %}
            {% if tag %}
              {% embed 'cfc_media_hub:badge' with { variant: 'light', attributes: create_attribute({ class: ['absolute', 'top-4', 'left-4'] }) } %}
                {% block label %}{{ tag }}{% endblock %}
              {% endembed %}
            {% endif %}
            {% if icon %}
              <div class="absolute top-4 right-4 w-9 h-9 rounded-full flex items-center justify-center backdrop-blur {{ s.highlight ? 'bg-white text-[#0F6E56]' : 'bg-white/85 text-neutral-700' }}">
                {% include 'cfc_media_hub:icon' with { name: icon, size: 'w-4 h-4' } only %}
              </div>
            {% endif %}
          </a>

          <div class="p-7">
            <h3 class="tracking-tight mb-3" style="font-size: 26px; font-weight: 600; letter-spacing: -0.02em;">
              <a href="{{ spaces_url }}#space-{{ s.id }}">{{ s.title }}</a>
            </h3>
            <p class="leading-relaxed mb-6 text-[14px] {{ s.highlight ? 'text-white/85' : 'text-neutral-600' }}">{{ s.summary }}</p>

            <ul class="space-y-2 mb-7">
              {% for f in s.features %}
                <li class="flex items-center gap-2 text-[13px] {{ s.highlight ? 'text-white/90' : 'text-neutral-700' }}">
                  {% include 'cfc_media_hub:icon' with { name: 'check', size: 'w-3.5 h-3.5 ' ~ (s.highlight ? 'text-[#CDEDE3]' : 'text-[#9F5434]') } only %}
                  {{ f }}
                </li>
              {% endfor %}
            </ul>

            <a href="{{ booking_base_url }}?space={{ s.id }}" class="w-full py-3.5 rounded-xl flex items-center justify-center gap-2 transition-colors font-semibold text-[13px] {{ s.highlight ? 'bg-white text-[#9F5434] hover:bg-[#9F5434]/10' : 'bg-[#9F5434] text-white hover:bg-[#8A4A2E]' }}">
              {{ s.cta_label }}
              {% include 'cfc_media_hub:icon' with { name: 'arrow-up-right', size: 'w-4 h-4' } only %}
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
