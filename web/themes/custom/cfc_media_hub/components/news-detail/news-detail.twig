{% set category_labels = { news: 'News', events: 'Events', updates: 'Updates', agenda: 'Agenda' } %}
{% set n = item %}

<section class="bg-white pt-16">
  <div class="max-w-[840px] mx-auto px-12">
    <a href="{{ news_url }}" class="inline-flex items-center gap-2 text-[13px] text-neutral-400 hover:text-neutral-900 transition-colors mb-10">
      {% include 'cfc_media_hub:icon' with { name: 'arrow-left', size: 'w-3.5 h-3.5' } only %}
      All news
    </a>

    <div class="flex items-center gap-3 mb-5">
      <span class="bg-neutral-950 text-white px-3 py-1 rounded-full text-[11px] font-semibold">{{ category_labels[n.category] ?? n.category }}</span>
      <span class="text-[12px] text-neutral-400 uppercase tracking-wide">{{ n.date }}</span>
    </div>

    <h1 class="tracking-tight text-neutral-900 mb-10" style="font-size: 40px; font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;">
      {{ n.title }}
    </h1>

    <div class="relative rounded-2xl overflow-hidden h-[380px] bg-neutral-100 mb-12">
      {% if n.image_url %}
        <img src="{{ n.image_url }}" alt="{{ n.title }}" class="w-full h-full object-cover" />
      {% else %}
        <div class="w-full h-full flex items-center justify-center">
          {% include 'cfc_media_hub:icon' with { name: 'newspaper', size: 'w-14 h-14', class: 'text-neutral-300' } only %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="bg-white pb-20">
  <div class="max-w-[840px] mx-auto px-12">
    {% if n.summary %}
      <p class="text-neutral-700 leading-relaxed text-[16px]" style="white-space: pre-line;">{{ n.summary }}</p>
    {% else %}
      <p class="text-neutral-400 leading-relaxed text-[15px] italic">No further details have been added for this item yet.</p>
    {% endif %}
  </div>
</section>
