<section class="bg-neutral-950 text-white py-36 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.08] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>
  <div class="absolute -top-32 -right-20 w-[500px] h-[500px] rounded-full bg-[#9F5434]/20 blur-3xl opacity-60"></div>
  <div class="absolute -bottom-40 -left-20 w-[400px] h-[400px] rounded-full bg-[#9F5434]/8 blur-3xl"></div>

  <div class="relative max-w-[1440px] mx-auto px-12 grid grid-cols-12 gap-12 items-center">
    <div class="col-span-7">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-6 h-[2px] bg-[#9F5434]"></div>
        <div class="text-[12px] uppercase tracking-[0.18em] text-[#9F5434] font-semibold">Start creating</div>
      </div>
      <h2 class="tracking-tight" style="font-size: 76px; font-weight: 600; line-height: 1.02; letter-spacing: -0.03em;">
        Ready to access<br />
        <span class="text-[#9F5434]">the hub?</span>
      </h2>
      <p class="mt-7 text-white/80 leading-relaxed max-w-[480px] text-[18px]">
        Book your space in seconds and start creating from Casablanca.
      </p>

      <div class="mt-10 flex items-center gap-4">
        {% embed 'cfc_media_hub:button' with { variant: 'white', size: 'md', href: booking_base_url } %}
          {% block icon %}{% include 'cfc_media_hub:icon' with { name: 'calendar', size: 'w-4 h-4' } only %}{% endblock %}
          {% block label %}Check availability{% endblock %}
        {% endembed %}
        <a href="mailto:mediahub@casablancafinancecity.com" class="border border-white/25 hover:bg-white/10 text-white px-8 py-4 rounded-full text-[14px] font-medium backdrop-blur-sm inline-flex items-center">
          Contact us
        </a>
      </div>
    </div>

    <div class="col-span-5">
      <div class="bg-white/[0.07] border border-white/15 backdrop-blur-sm rounded-2xl p-8">
        <div class="text-[12px] uppercase tracking-wide text-[#9F5434] font-semibold mb-5">Next available slots</div>
        <div class="space-y-3">
          {% for s in slots %}
            <div class="flex items-center justify-between py-3 border-b border-white/10 last:border-0">
              <div>
                <div class="text-[14px] font-semibold">{{ s.title }}</div>
                <div class="text-[12px] text-white/60 mt-0.5">{{ s.day_label }} &middot; {{ s.time_range }}</div>
              </div>
              <a href="{{ s.book_url }}" class="text-[12px] bg-white text-[#9F5434] px-3.5 py-1.5 rounded-md hover:bg-[#9F5434] hover:text-white transition-colors font-semibold">
                Book
              </a>
            </div>
          {% else %}
            <p class="text-[13px] text-white/60">No slots available right now — check the full calendar.</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
