<div class="min-h-screen bg-[#FCFCFB] flex flex-col">
  <div class="w-full max-w-[1440px] mx-auto px-5 md:px-12 h-16 md:h-20 flex items-center justify-between gap-3 border-b border-neutral-100 bg-white">
    <a href="{{ home_url }}" class="flex items-center gap-2 text-[13px] text-neutral-500 hover:text-neutral-900 transition-colors shrink-0">
      {% include 'cfc_media_hub:icon' with { name: 'arrow-left', size: 'w-4 h-4' } only %}
      <span class="hidden sm:inline">Back</span>
    </a>
    {% include 'cfc_media_hub:journey-steps' with { active: [1] } only %}
    <a href="{{ home_url }}" class="text-[13px] text-neutral-400 hover:text-neutral-700 transition-colors shrink-0">Cancel</a>
  </div>

  <div class="flex-1 flex items-center justify-center px-5 md:px-12 py-10 md:py-16">
    <div class="max-w-[560px] mx-auto text-center">
      <div class="w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-[#9F5434]/10 text-[#9F5434] flex items-center justify-center mx-auto mb-6 md:mb-8">
        {% include 'cfc_media_hub:icon' with { name: 'mail', size: 'w-6 h-6 md:w-7 md:h-7' } only %}
      </div>

      <div class="text-[12px] uppercase tracking-[0.18em] text-[#9F5434] mb-4 font-semibold">Account created &middot; Verify your email</div>
      <h1 class="tracking-tight text-neutral-900 mb-5 leading-[1.15] md:leading-[1.1] text-[30px] md:text-[42px] font-semibold tracking-[-0.025em]">Check your inbox.</h1>
      <p class="text-neutral-600 leading-relaxed mb-2 text-[15px] md:text-[16px]">We've sent a verification code to</p>
      <p class="text-[#9F5434] mb-8 text-[15px] md:text-[16px] font-semibold">{{ email }}</p>
      <p class="text-neutral-500 leading-relaxed mb-8 md:mb-10 text-[14px]">Enter the 6-digit code below to verify your account. Once verified, you can continue to book your space.</p>

      <div class="cfc-form-shell text-left">
        {{ form }}
      </div>
    </div>
  </div>
</div>
