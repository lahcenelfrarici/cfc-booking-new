<div class="min-h-screen bg-[#FCFCFB] flex flex-col">
  <div class="w-full max-w-[1440px] mx-auto px-12 h-20 flex items-center justify-between border-b border-neutral-100 bg-white">
    <a href="{{ home_url }}" class="flex items-center gap-2 text-[13px] text-neutral-500 hover:text-neutral-900 transition-colors">
      {% include 'cfc_media_hub:icon' with { name: 'arrow-left', size: 'w-4 h-4' } only %}
      Back
    </a>
    {% include 'cfc_media_hub:journey-steps' with { active: [1] } only %}
    <a href="{{ home_url }}" class="text-[13px] text-neutral-400 hover:text-neutral-700 transition-colors">Cancel</a>
  </div>

  <div class="flex-1 flex items-center justify-center px-12 py-16">
    <div class="max-w-[560px] mx-auto text-center">
      <div class="w-16 h-16 rounded-2xl bg-[#9F5434]/10 text-[#9F5434] flex items-center justify-center mx-auto mb-8">
        {% include 'cfc_media_hub:icon' with { name: 'mail', size: 'w-7 h-7' } only %}
      </div>

      <div class="text-[12px] uppercase tracking-[0.18em] text-[#9F5434] mb-4" style="font-weight: 600;">Account created &middot; Verify your email</div>
      <h1 class="tracking-tight text-neutral-900 mb-5" style="font-size: 42px; font-weight: 600; line-height: 1.1; letter-spacing: -0.025em;">Check your inbox.</h1>
      <p class="text-neutral-600 leading-relaxed mb-2" style="font-size: 16px;">We've sent a verification code to</p>
      <p class="text-[#9F5434] mb-8" style="font-size: 16px; font-weight: 600;">{{ email }}</p>
      <p class="text-neutral-500 leading-relaxed mb-10" style="font-size: 14px;">Enter the 6-digit code below to verify your account. Once verified, you can continue to book your space.</p>

      <div class="cfc-form-shell text-left">
        {{ form }}
      </div>
    </div>
  </div>
</div>
