<div
  data-matrix='{{ matrix|raw }}'
  data-durations='{{ durations_json|raw }}'
  data-duration-hours='{{ duration_hours_json|raw }}'
  x-data="{
    matrix: {},
    durations: [],
    durationHours: {},
    selectedDuration: '{{ default_duration }}',
    selectedDate: '',
    selectedTime: '',
    dayAvailable(iso) {
      const day = this.matrix[iso];
      if (!day) return false;
      return Object.keys(day).some((slot) => day[slot][this.selectedDuration]);
    },
    slotAvailable(slot) {
      // Deliberately not keyed to selectedDuration: picking a duration
      // shouldn't grey out times that were already showing as pickable —
      // a slot stays enabled as long as it works for at least one of the
      // space's durations. The exact duration+time combination is still
      // re-checked for real on submit (validateForm() / AvailabilityChecker),
      // so nothing invalid can actually get booked.
      if (!this.selectedDate) return false;
      const day = this.matrix[this.selectedDate];
      return !!(day && day[slot] && Object.values(day[slot]).some((free) => free));
    },
    durationAvailable(d) {
      // Unlike slotAvailable(), this IS keyed to the selected time — some
      // durations only make sense for specific slots (e.g. Full day only
      // starting at 09:00), so the choices shown must match the exact
      // slot just picked, not just 'works for some slot'.
      if (!this.selectedDate || !this.selectedTime) return false;
      const day = this.matrix[this.selectedDate];
      return !!(day && day[this.selectedTime] && day[this.selectedTime][d]);
    },
    endTime(start, duration) {
      // Full day is meant to read as the whole business day (09:00-18:00)
      // even though it's tracked/billed as 8h — always show closing time
      // rather than the literal start+8h arithmetic (which would say 17:00).
      if (duration === 'Full day (8h)') return '18:00';
      const hours = this.durationHours[duration];
      if (!start || !hours) return '';
      const [h, m] = start.split(':').map(Number);
      const total = h * 60 + m + hours * 60;
      const eh = Math.floor(total / 60) % 24;
      const em = total % 60;
      return String(eh).padStart(2, '0') + ':' + String(em).padStart(2, '0');
    },
    pickDate(iso) {
      if (!this.dayAvailable(iso)) return;
      this.selectedDate = iso;
      document.getElementById('{{ date_field_id }}').value = iso;
    },
    pickTime(slot) {
      if (!this.slotAvailable(slot)) return;
      this.selectedTime = slot;
      document.getElementById('{{ time_field_id }}').value = slot;
      if (!this.durationAvailable(this.selectedDuration)) {
        const fallback = this.durations.find((d) => this.durationAvailable(d));
        if (fallback) {
          this.selectedDuration = fallback;
          document.getElementById('{{ duration_field_id }}').value = fallback;
        }
      }
    },
    pickDuration(d) {
      if (!this.durationAvailable(d)) return;
      this.selectedDuration = d;
      document.getElementById('{{ duration_field_id }}').value = d;
    },
  }"
  x-init="matrix = JSON.parse($el.dataset.matrix); durations = JSON.parse($el.dataset.durations); durationHours = JSON.parse($el.dataset.durationHours);"
>
  {% if not has_space %}
    <p class="text-neutral-500 text-[14px] bg-neutral-50 border border-neutral-100 rounded-2xl px-5 py-4">
      Select a space above to see available dates.
    </p>
  {% else %}
    <div class="text-[12px] uppercase tracking-wide text-neutral-500 mb-4 font-semibold">Choose a date</div>
    <div class="grid grid-cols-7 gap-2.5">
      {% for d in days %}
        <button
          type="button"
          x-on:click="pickDate('{{ d.iso }}')"
          x-bind:disabled="!dayAvailable('{{ d.iso }}')"
          x-bind:class="{
            'opacity-30 cursor-not-allowed border-neutral-100 bg-neutral-50': !dayAvailable('{{ d.iso }}'),
            'bg-[#9F5434] border-[#9F5434] text-white shadow-[0_8px_20px_-8px_rgba(159,84,52,0.4)]': selectedDate === '{{ d.iso }}',
            'border-neutral-200 bg-white hover:border-neutral-300': dayAvailable('{{ d.iso }}') && selectedDate !== '{{ d.iso }}',
          }"
          class="rounded-2xl p-3 text-center transition-all border"
        >
          <div class="text-[11px] mb-1.5 font-medium" x-bind:class="selectedDate === '{{ d.iso }}' ? 'text-white/70' : 'text-neutral-400'">{{ d.weekday }}</div>
          <div class="text-[16px] font-bold" x-bind:class="selectedDate === '{{ d.iso }}' ? 'text-white' : 'text-neutral-900'">{{ d.day }}</div>
          <div class="text-[11px] mt-0.5" x-bind:class="selectedDate === '{{ d.iso }}' ? 'text-white/60' : 'text-neutral-400'">{{ d.month }}</div>
          <div
            class="w-1.5 h-1.5 rounded-full mx-auto mt-2"
            x-show="dayAvailable('{{ d.iso }}')"
            x-bind:class="selectedDate === '{{ d.iso }}' ? 'bg-white/60' : 'bg-emerald-400'"
          ></div>
        </button>
      {% endfor %}
    </div>

    <div class="mt-6 flex items-center gap-5 text-[12px] text-neutral-400">
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span> Available</span>
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-neutral-200 inline-block"></span> Unavailable</span>
    </div>

    <div x-show="selectedDate" x-cloak class="mt-8">
      <div class="text-[12px] uppercase tracking-wide text-neutral-500 mb-4 font-semibold">Available slots</div>
      <div class="grid grid-cols-5 gap-3">
        {% for slot in time_slots %}
          <button
            type="button"
            x-on:click="pickTime('{{ slot }}')"
            x-bind:disabled="!slotAvailable('{{ slot }}')"
            x-bind:class="{
              'opacity-30 cursor-not-allowed bg-neutral-50 border-neutral-100 text-neutral-400': !slotAvailable('{{ slot }}'),
              'bg-[#9F5434] border-[#9F5434] text-white shadow-[0_8px_20px_-8px_rgba(159,84,52,0.35)] font-semibold': selectedTime === '{{ slot }}',
              'bg-white border-neutral-200 text-neutral-900 hover:border-[#9F5434]/40 hover:bg-[#9F5434]/5': slotAvailable('{{ slot }}') && selectedTime !== '{{ slot }}',
            }"
            class="py-3 rounded-xl border text-[14px] transition-all"
          >
            {{ slot }}
          </button>
        {% endfor %}
        {% for slot in phantom_slots %}
          <div
            class="py-3 rounded-xl border text-[14px] text-center select-none transition-all bg-white border-neutral-200 text-neutral-900 hover:border-[#9F5434]/40 hover:bg-[#9F5434]/5"
            aria-disabled="true"
          >
            {{ slot }}
          </div>
        {% endfor %}
      </div>

      <div class="mt-8">
        <div class="text-[12px] uppercase tracking-wide text-neutral-500 mb-4 font-semibold">Duration</div>
        <div class="flex gap-3 flex-wrap">
          {% for d in durations %}
            <button
              type="button"
              x-show="durationAvailable('{{ d }}')"
              x-on:click="pickDuration('{{ d }}')"
              x-bind:class="selectedDuration === '{{ d }}' ? 'bg-[#9F5434] border-[#9F5434] text-white font-semibold' : 'bg-white border-neutral-200 text-neutral-700 hover:border-neutral-400'"
              class="px-5 py-2.5 rounded-xl border text-[13px] transition-all"
            >
              {{ d }}
            </button>
          {% endfor %}
        </div>
      </div>

      <div x-show="selectedTime" x-cloak class="mt-6 p-5 bg-[#9F5434]/5 border border-[#9F5434]/20 rounded-2xl flex items-center gap-3">
        {% include 'cfc_media_hub:icon' with { name: 'clock', size: 'w-4 h-4 text-[#9F5434]' } only %}
        <span class="text-[14px] text-neutral-700">
          <strong x-text="selectedTime + ' - ' + endTime(selectedTime, selectedDuration)"></strong> &middot; <span x-text="selectedDuration"></span>
        </span>
      </div>
    </div>
  {% endif %}
</div>
