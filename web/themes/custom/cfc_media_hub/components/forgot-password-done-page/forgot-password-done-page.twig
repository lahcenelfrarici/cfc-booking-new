<div class="min-h-screen bg-[#FCFCFB] flex flex-col">
  <div class="w-full max-w-[1440px] mx-auto px-12 h-20 flex items-center justify-between border-b border-neutral-100 bg-white">
    <a href="{{ home_url }}" class="flex items-center gap-2 text-[13px] text-neutral-500 hover:text-neutral-900 transition-colors">
      {% include 'cfc_media_hub:icon' with { name: 'arrow-left', size: 'w-4 h-4' } only %}
      Back
    </a>
    <span class="text-[13px] text-neutral-400">Reset your password</span>
    <a href="{{ home_url }}" class="text-[13px] text-neutral-400 hover:text-neutral-700 transition-colors">Cancel</a>
  </div>

  <div class="flex-1 flex items-center justify-center px-12 py-16">
    <div class="w-full max-w-[440px]">
      <div class="flex justify-center mb-10">
        <img src="{{ logo_url }}" alt="CFC Media Hub" class="h-16 w-auto" />
      </div>

      <div class="bg-white rounded-3xl border border-neutral-200 shadow-[0_24px_60px_-20px_rgba(159,84,52,0.08)] p-10 text-center">
        <div class="w-14 h-14 rounded-full bg-[#9F5434]/10 flex items-center justify-center mx-auto mb-6">
          {% include 'cfc_media_hub:icon' with { name: 'check-circle-2', size: 'w-7 h-7 text-[#9F5434]' } only %}
        </div>

        <h2 class="tracking-tight text-neutral-900 mb-2" style="font-size: 24px; font-weight: 600; letter-spacing: -0.015em;">Password updated.</h2>
        <p class="text-neutral-500 leading-relaxed mb-8 max-w-[300px] mx-auto" style="font-size: 14px;">
          Your password has been successfully reset. You can now sign in with your new password.
        </p>

        <a href="{{ sign_in_url }}" class="w-full bg-[#9F5434] hover:bg-[#8A4A2E] text-white py-3.5 rounded-2xl flex items-center justify-center gap-2 transition-colors font-semibold text-[14px]">
          Return to sign in
          {% include 'cfc_media_hub:icon' with { name: 'arrow-right', size: 'w-4 h-4' } only %}
        </a>
      </div>
    </div>
  </div>
</div>
