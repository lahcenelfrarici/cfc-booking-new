<div class="min-h-screen bg-[#FCFCFB] flex flex-col">
  <div class="w-full max-w-[1440px] mx-auto px-5 md:px-12 h-16 md:h-20 flex items-center justify-between gap-3 border-b border-neutral-100 bg-white">
    <a href="{{ home_url }}" class="flex items-center gap-2 text-[13px] text-neutral-500 hover:text-neutral-900 transition-colors shrink-0">
      {% include 'cfc_media_hub:icon' with { name: 'arrow-left', size: 'w-4 h-4' } only %}
      <span class="hidden sm:inline">Back</span>
    </a>
    <span class="text-[13px] text-neutral-400 truncate">Reset your password</span>
    <a href="{{ home_url }}" class="text-[13px] text-neutral-400 hover:text-neutral-700 transition-colors shrink-0">Cancel</a>
  </div>

  <div class="flex-1 flex items-center justify-center px-5 md:px-12 py-10 md:py-16">
    <div class="w-full max-w-[440px]">
      <div class="flex justify-center mb-8 md:mb-10">
        <img src="{{ logo_url }}" alt="CFC Media Hub" class="h-14 md:h-16 w-auto" />
      </div>

      <div class="bg-white rounded-2xl md:rounded-3xl border border-neutral-200 shadow-[0_24px_60px_-20px_rgba(159,84,52,0.08)] p-6 md:p-10">
        <div class="w-12 h-12 rounded-2xl bg-[#9F5434]/10 flex items-center justify-center mb-6">
          {% include 'cfc_media_hub:icon' with { name: 'mail', size: 'w-[22px] h-[22px] text-[#9F5434]' } only %}
        </div>

        <h1 class="tracking-tight text-neutral-900 mb-1 text-[26px] md:text-[28px] font-semibold tracking-[-0.02em]">Check your email</h1>
        <p class="text-neutral-500 mb-1 leading-relaxed text-[14px]">We've sent a verification code to</p>
        <p class="text-[#9F5434] mb-8 text-[14px] font-semibold">{{ email }}</p>

        <div class="cfc-form-shell">
          {{ form }}
        </div>
      </div>
    </div>
  </div>
</div>
