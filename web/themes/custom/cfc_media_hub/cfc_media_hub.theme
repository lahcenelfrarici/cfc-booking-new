<?php

/**
 * @file
 * Preprocess functions for the CFC Media Hub theme.
 */

/**
 * Implements hook_preprocess_html().
 */
function cfc_media_hub_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = 'bg-paper';
  $variables['attributes']['class'][] = 'text-[color:var(--ink-900)]';
}
